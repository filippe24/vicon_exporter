    //  if (`strCompare $first "I"` == 0) $first = "i";
    //  if (`strCompare $first "J"` == 0) $first = "j";
    //  if (`strCompare $first "K"` == 0) $first = "k";
    //  if (`strCompare $first "L"` == 0) $first = "l";
    //  if (`strCompare $first "M"` == 0) $first = "m";
