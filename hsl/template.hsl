//-- export full scene ----------
select -all;
saveFile -s "{EXPORT_DIR}/markers_world.c3d";

//------- export clapperboard ---
select ; // deselect.
selectByName "{CLAPPERBOARD_NAME}*";
string $array[] =  `getModules -selected`;
if( `getCount $array` > 0 )
{
	selectChildren  -recursive -a $array ;
}
saveFile -s "{EXPORT_DIR}/clapperboard.c3d";
select ; // deselect.
{ADDITIONAL_PROP_EXPORTS}
{CALIBRATION_MARKER_EXPORT}
//--------- export actors -------
selectProps;
select -invert;

string $sel[] = `getModules -sel -type Character`;
int $numsel = `getCount $sel`;
int $i;
int $j;

string $first;
string $actor_file_stem;
string $filename;

string $actors_export_directory;
$actors_export_directory = ("{EXPORT_DIR}/{ACTORS_FOLDER}/");

for ($i = 0; $i < $numsel; $i+= 1)
{
    print $sel[$i];

    // Select full hierarchy
    selectChildren -recursive $sel[$i];

    // Keep legacy three-letter names when unique. Use the full character name
    // when another actor shares the same prefix, so files cannot overwrite.
    $first = `strLeft $sel[$i] 3`;
    $actor_file_stem = $first;
    for ($j = 0; $j < $numsel; $j += 1)
    {
        if ($j != $i && `strLeft $sel[$j] 3` == $first)
        {
            $actor_file_stem = $sel[$i];
        }
    }

    // Build path
	string $filename_c3d;
	string $filename_fbx;
	string $filename_bvh;
	string $filename_mcp;
    $filename_c3d = ($actors_export_directory + $actor_file_stem + "_.c3d");
    $filename_fbx = ($actors_export_directory + $actor_file_stem + "_.fbx");
    $filename_bvh = ($actors_export_directory + $actor_file_stem + "_.bvh");
    $filename_mcp = ($actors_export_directory + $actor_file_stem + "_.mcp");


    // Export
    saveFile -s $filename_c3d;
    saveFile -s $filename_fbx;
    saveFile -s $filename_bvh;
    saveFile -s $filename_mcp;
}
