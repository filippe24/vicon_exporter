//-- export full scene ----------
select -all;
saveFile -s "{EXPORT_DIR}/markers_world.c3d";

//------- export clapperboard ---
select ; // deselect.
selectByName "{CLAPPERBOARD_NAME}*";
string $array[] =  `getModules -selected`;
if( `getCount $array` > 0 )
{
	selectChildren  -recursive -a $array ;
}
saveFile -s "{EXPORT_DIR}/clapperboard.c3d";
select ; // deselect.
//--------- export actors -------
selectProps;
select -invert;

string $sel[] = `getModules -sel -type Character`;
int $numsel = `getCount $sel`;
int $i;

string $first;
string $filename;

string $actors_export_directory;
$actors_export_directory = ("{EXPORT_DIR}/{ACTORS_FOLDER}/");

for ($i = 0; $i < $numsel; $i+= 1)
{
    print $sel[$i];

    // Select full hierarchy
    selectChildren -recursive $sel[$i];

    // Get first letter
    $first = `strLeft $sel[$i] 3`;

    // Build path
	string $filename_mcp;

    $filename_mcp = ($actors_export_directory + $first + "_.mcp");


    // Export
    saveFile -s $filename_mcp;
}