// ****** select actors.
selectProps;
select -invert;

string $sel[] = `getModules -sel -type Character`;
int $numsel = `getCount $sel`;
int $i;
int $j;

string $first;
string $actor_file_stem;
string $filename;

string $actors_export_directory;
$actors_export_directory = ("{EXPORT_DIR}/{ACTORS_FOLDER}/");

for ($i = 0; $i < $numsel; $i+= 1)
{
	print $sel[$i];

	select  $sel[$i];

	// select full hierarchy.
	selectChildren -recursive $sel[$i];
	// set current subject.
	setCurrentSubject $sel[$i];

	// load the retarget file.
	// loadFile -importType "curClipCreateNew" "C:/Users/jovan/Documents/project/python/vicon_exporter/models/default_mannequin.vsr";
	loadFile -importType "curClipCreateNew" "{RETARGET_VSR_PATH}";

	retarget -selectedCharacters;

	// select ;
    select ($sel[$i]+"\\\\Retargeting");
    SelectChildren_Add_All;


	// get first letter
	$first = `strLeft $sel[$i] 3`;
	$actor_file_stem = $first;
	for ($j = 0; $j < $numsel; $j += 1)
	{
		if ($j != $i && `strLeft $sel[$j] 3` == $first)
		{
			$actor_file_stem = $sel[$i];
		}
	}

	// build path.
	string $filename_fbx;
	$filename_fbx = ($actors_export_directory + $actor_file_stem + "_{NEW_FILE_NAME}.fbx");

	// export.
	saveFile -s $filename_fbx;

}
