// ****** select actors.
selectProps;
select -invert;

string $sel[] = `getModules -sel -type Character`;
int $numsel = `getCount $sel`;
int $i;
int $j;

string $first;
string $actor_file_stem;
string $filename;

string $actors_export_directory;
$actors_export_directory = ("{EXPORT_DIR}/{ACTORS_FOLDER}/");

for ($i = 0; $i < $numsel; $i+= 1)
{
	print $sel[$i];

	string $subject;
	$subject = $sel[$i];

	select  $subject;

	// select full hierarchy.
	selectChildren -recursive $subject;
	// set current subject.
	setCurrentSubject $subject;

	// load the retarget file.
	// loadFile -importType "curClipCreateNew" "C:/Users/jovan/Documents/project/python/vicon_exporter/models/default_mannequin.vsr";
	loadFile -importType "curClipCreateNew" "{RETARGET_VSR_PATH}";

	selectByName $subject;
	setConstraint;
	retarget -selectedCharacters;

	// move forearm twist from forearm to hand on both sides, then solve and retarget again.
	string $r_forearm;
	string $r_hand;
	string $l_forearm;
	string $l_hand;
	$r_forearm = ($subject + "\\Solving\\Hips\\Spine\\Spine1\\Spine2\\Spine3\\RightShoulder\\RightArm\\RightForeArm");
	$r_hand = ($r_forearm + "\\RightHand");
	$l_forearm = ($subject + "\\Solving\\Hips\\Spine\\Spine1\\Spine2\\Spine3\\LeftShoulder\\LeftArm\\LeftForeArm");
	$l_hand = ($l_forearm + "\\LeftHand");

	setProperty "DOF" "Rz" false -onMod $r_forearm;
	setProperty "DOF" "Rz" true -onMod $r_hand;
	setProperty "DOF" "Rz" false -onMod $l_forearm;
	setProperty "DOF" "Rz" true -onMod $l_hand;

	selectByName $subject;
	solve;

	selectByName $subject;
	setConstraint;
	retarget -selectedCharacters;

	// select ;
    select ($subject+"\\\\Retargeting");
    SelectChildren_Add_All;


	// get first letter
	$first = `strLeft $subject 3`;
	$actor_file_stem = $first;
	for ($j = 0; $j < $numsel; $j += 1)
	{
		if ($j != $i && `strLeft $sel[$j] 3` == $first)
		{
			$actor_file_stem = $subject;
		}
	}

	// build path.
	string $filename_fbx;
	$filename_fbx = ($actors_export_directory + $actor_file_stem + "_{NEW_FILE_NAME}.fbx");

	// export.
	saveFile -s $filename_fbx;

}
